# Rewrite Engine — URLs limpias para CEROCLIMA en Apache/cPanel
# ──────────────────────────────────────────────────────────────
RewriteEngine On

# ── Forzar HTTPS (descomentar si el dominio tiene SSL) ───────
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── Redirigir www → sin-www (o viceversa, elegir uno) ────────
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# ── No procesar archivos/carpetas que existen físicamente ────
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ── URLs limpias: /ruta → /ruta.html ─────────────────────────
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# ── Página 404 personalizada ─────────────────────────────────
ErrorDocument 404 /404.html

# ── MIME types especiales ────────────────────────────────────
# React Server Components payload (navegación client-side vinext)
AddType text/x-component .rsc

# WebP y fuentes modernas (por si Apache no los reconoce)
AddType image/webp .webp
AddType font/woff2 .woff2
AddType image/svg+xml .svg

# ── Compresión gzip ──────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE text/x-component
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE application/json
</IfModule>

# ── Cache de assets estáticos ────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # Assets con hash en el nombre → inmutable, 1 año
  <FilesMatch "\.(js|css|woff2)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Imágenes y videos → 1 mes
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|mp4)$">
    ExpiresDefault "access plus 1 month"
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # PDFs → 1 semana
  <FilesMatch "\.pdf$">
    ExpiresDefault "access plus 1 week"
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # HTML y RSC → no cachear agresivamente
  <FilesMatch "\.(html|rsc)$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Headers de seguridad ─────────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
